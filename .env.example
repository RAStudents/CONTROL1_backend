# Set each secret independently. openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
CURSOR_SECRET=
CURSOR_KEY_ID=v1
# Comma-separated HTTPS CDN hosts, optionally with explicit ports
CDN_HOSTS=
# Comma-separated browser origin allowlist, including scheme; * allows any origin
CORS_ORIGINS=
MAX_INGEST_BATCH_V1=100
BIND_HOST=127.0.0.1
HTTP_PORT=8080
# Set BIND_HOST=0.0.0.0 for LAN access. Optional LAN_HTTP_PORT overrides HTTP_PORT.

MAX_SNAPSHOT_ITEMS=100000
